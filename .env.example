# Copy to .env and fill in. Every setting has a default in krl/config.py.

# Database (MySQL or MariaDB)
KRL_DB_HOST=127.0.0.1
KRL_DB_PORT=3306
KRL_DB_USER=krl
KRL_DB_PASSWORD=change-me
KRL_DB_NAME=krl

# Camera: a video file for testing, or an RTSP URL for a live camera
KRL_SOURCE=data/test.mp4
# Carriage this camera covers, and its seat capacity
KRL_GERBONG=1
KRL_SEAT_CAPACITY=25
# Counting line: position across the frame (0 = left edge, 1 = right edge)
KRL_LINE_POSITION=0.5
# Pixels a person must move past the line before it counts (ignores standing on the line)
KRL_LINE_MARGIN_PX=20
# Which direction of travel frees a seat: Left or Right
KRL_SEAT_FREED_DIRECTION=Left

# Detection
KRL_MODEL=yolo11n.pt
KRL_CONF=0.2
KRL_IMG_SIZE=1024
KRL_DUPLICATE_IOU=0.5
